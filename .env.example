# ==========================================
# AirGuard AI - Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="AirGuard AI"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (Neon / Supabase PostgreSQL with PostGIS, or SQLite fallback)
# Production / Neon PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://user:password@ep-sample-12345.us-east-2.aws.neon.tech/airguard?sslmode=require"
# Local development SQLite fallback:
DATABASE_URL="sqlite+aiosqlite:///./airguard_dev.db"

# External AI Service Credentials (Optional for local deterministic fallback)
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Open-Meteo Air Quality Configuration
OPEN_METEO_BASE_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
OPEN_METEO_WEATHER_URL="https://api.open-meteo.com/v1/forecast"
AQI_CACHE_TTL_SECONDS=1800

# Rate Limiting & Performance
RATE_LIMIT_PER_MINUTE=60
