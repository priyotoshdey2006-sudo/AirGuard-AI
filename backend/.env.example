# ==========================================
# AirGuard AI - Environment Configuration Template
# ==========================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="AirGuard AI"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security & Authentication (MUST be a random min-32 character string in production)
# In development, a default placeholder is accepted; production startup will fail if left default.
SECRET_KEY="generate-secure-random-key-for-prod-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database & Docker PostGIS Configuration
POSTGRES_DB="airguard"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="set_strong_database_password_here"
POSTGRES_PORT=5432

# Local development SQLite default:
DATABASE_URL="sqlite:///./airguard_dev.db"
# Local Docker / PostGIS 16 instance:
# DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"
# Production PostgreSQL 16 + PostGIS 3.x (Neon, Supabase, or AWS RDS):
# DATABASE_URL="postgresql+asyncpg://user:password@hostname:5432/airguard_db?ssl=require"

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true

# Geospatial Query Settings
DEFAULT_NEARBY_RADIUS_KM=50.0
MAX_NEARBY_RADIUS_KM=250.0

# Multi-Worker Rate Limiting & Shared Cache (Optional for dev, recommended in multi-worker production)
REDIS_URL=""
# REDIS_URL="redis://localhost:6379/0"

# AI Copilot Provider Credentials (Optional for local deterministic health rules fallback)
GEMINI_API_KEY=""
GROQ_API_KEY=""
DEFAULT_AI_PROVIDER="gemini"

# Open-Meteo Atmospheric Model Settings
OPEN_METEO_BASE_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
OPEN_METEO_WEATHER_URL="https://api.open-meteo.com/v1/forecast"
AQI_CACHE_TTL_SECONDS=1800

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Server Port (automatically assigned by Render via $PORT in production)
PORT=8000
