ENVIRONMENT=development
PROJECT_NAME="AirGuard AI"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Neon / Supabase PostGIS connection string or local SQLite fallback
DATABASE_URL="sqlite+aiosqlite:///./airguard_dev.db"

# AI Service Keys (Optional: deterministic rule engine acts as fallback)
GEMINI_API_KEY=""
GROQ_API_KEY=""

OPEN_METEO_BASE_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
OPEN_METEO_WEATHER_URL="https://api.open-meteo.com/v1/forecast"
AQI_CACHE_TTL_SECONDS=1800
